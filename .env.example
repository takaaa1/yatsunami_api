# ===== AMBIENTE =====
NODE_ENV=development
PORT=3000

# ===== RUNTIME (produção VPS/Docker) =====
# long-running = PM2/Docker (WS, crons, jobs in-process) | serverless = Vercel/Lambda (só REST)
RUNTIME_MODE=long-running
CRON_ENABLED=true

# ===== URLs =====
API_URL=http://localhost:3000

# ===== BANCO LOCAL (Docker: docker compose -f docker-compose.dev.yml up -d) =====
DATABASE_URL=postgresql://yatsunami_dev:yatsunami_dev_local@localhost:5434/yatsunami_dev
DIRECT_URL=postgresql://yatsunami_dev:yatsunami_dev_local@localhost:5434/yatsunami_dev

# ===== BANCO PRODUÇÃO (VPS) =====
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/yatsunami_db

# ===== STORAGE =====
# local = disco (dev) | r2 = Cloudflare R2 (produção)
STORAGE_BACKEND=local
UPLOADS_PATH=/var/www/yatsunami/uploads
ASSETS_PUBLIC_URL=https://media.yatsunami.com.br

# ===== Cloudflare R2 =====
CLOUDFLARE_S3_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
R2_BUCKET=yatsunami
R2_PUBLIC_BASE_URL=https://media.yatsunami.com.br

# ===== JWT =====
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== SESSÃO RENOVÁVEL =====
# Access token curto, só para clientes que enviam sessaoRenovavel.
ACCESS_TOKEN_TTL_SECONDS=3600
# Com "Lembrar-me": inatividade de 90 dias, teto absoluto de 365.
SESSION_REMEMBER_IDLE_DAYS=90
SESSION_REMEMBER_ABSOLUTE_DAYS=365
# Sem "Lembrar-me": inatividade de 24 h, teto de 7 dias.
SESSION_EPHEMERAL_IDLE_HOURS=24
SESSION_EPHEMERAL_ABSOLUTE_DAYS=7
# Reapresentar um refresh já rotacionado dentro desta janela não revoga a família.
SESSION_REUSE_GRACE_SECONDS=30

# ===== MAIL (Brevo) =====
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@yatsunami.com.br
MAIL_FROM_NAME=Yatsunami
